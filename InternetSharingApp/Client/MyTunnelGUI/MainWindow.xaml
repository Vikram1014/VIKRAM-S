<Window x:Class="MyTunnelGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTunnel" Height="450" Width="400"
        Background="#2D2D30">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="INTERNET STATUS" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="● Connected" Foreground="#4CAF50" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Text="Connection: Ethernet" Foreground="LightGray"/>
            <TextBlock Text="Download: 92 Mbps" Foreground="LightGray"/>
            <TextBlock Text="Upload: 41 Mbps" Foreground="LightGray" Margin="0,0,0,20"/>

            <Border BorderBrush="#555" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>

            <TextBlock Text="SHARE INTERNET" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,10,0,10"/>
            <Button x:Name="StartSharingButton" Content="START SHARING" Background="#007ACC" Foreground="White" Padding="10" Margin="0,0,0,10" Click="StartSharingButton_Click"/>

            <TextBlock Text="Connection Code" Foreground="LightGray" Margin="0,10,0,5"/>
            <TextBox x:Name="ConnectionCodeTextBox" Text="" Background="#333" Foreground="White" IsReadOnly="True" HorizontalAlignment="Left" Width="100"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Connected devices: 0" Foreground="Gray"/>
    </Grid>
</Window>
